{
	"extends": ["../../tsconfig.json"],
	"include": ["src"],
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "src",
		"paths": {
			"@/*": ["./src/*"],
			"@middleware/*": ["./src/middleware/*"],
			"@controllers/*": ["./src/controllers/*"],
			"@routes/*": ["./src/routes/*"],
			"@sockets/*": ["./src/sockets/*"],
			"@app-types/*": ["./src/types/*"],
			"@utils/*": ["./src/utils/*"],
			"@database/*": ["./src/database/*"],
			"@config/*": ["./src/config/*"],
			"@game/*": ["./src/game/*"]
		}
	}
}
